# Supabase (auth + inventory)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Solana (real payments)
# mainnet-beta | devnet
VITE_SOLANA_NETWORK=devnet
# Optional custom RPC (Helius, Triton, etc.). Defaults to public cluster endpoint.
VITE_SOLANA_RPC_URL=
# Treasury wallet that receives pack payments (base58 pubkey)
VITE_TREASURY_WALLET=
